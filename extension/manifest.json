{
  "manifest_version": 3,
  "name": "HOARD — Contextual Link Saver",
  "short_name": "HOARD",
  "version": "1.0.0",
  "description": "Neo-brutalist contextual bookmark manager extension for articles, videos, repos, papers, and apps.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Save to HOARD (Alt+Shift+H)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "save-to-hoard": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Instantly save current tab to HOARD"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
